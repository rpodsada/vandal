# Supply-chain guards (PLAN 3I.4; DEVELOPMENT.md › Dependencies).
# Skip versions published in the last 7 days: most hijacked releases are caught and pulled by then.
# An exact too-new version makes npm 11.12 loop instead of failing; override with --min-release-age=0.
min-release-age=7
# Never run packages' install scripts. No dependency needs one (fsevents is macOS-only).
ignore-scripts=true
# Registry packages only, never straight from a git repo.
allow-git=none
