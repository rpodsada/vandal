{
  "manifest_version": 3,
  "name": "Vandal Screen Capture",
  "short_name": "Vandal",
  "version": "0.1.0",
  "description": "Capture the visible area, a region or a whole web page. Copy it, save it, or open it in Vandal's editor.",
  "homepage_url": "https://vandalscreenshot.com",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Vandal",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open the popup"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture the visible area"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Capture a region"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Capture the full page"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "downloads", "nativeMessaging", "scripting", "storage"]
}
